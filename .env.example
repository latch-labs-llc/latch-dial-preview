# Build-time configuration (Vite). Copy to .env.production for a deploy; .env.* is gitignored.
# None of these are secrets: everything here ships in the bundle.

# HTTP RPC. Activity needs getProgramAccounts, which the public devnet RPC refuses — use a provider.
VITE_RPC_URL=https://api.devnet.solana.com
# Independent second RPC for the evidence packet cross-check (optional).
VITE_RPC_URL_2=
# WebSocket for confirmations. Keep this on the public devnet socket when VITE_RPC_URL is a
# metered provider: provider WebSocket caps are shared with every site using the same key.
VITE_WS_URL=wss://api.devnet.solana.com
# The app's domain, written into the backup-key messages wallets sign. FIXED per deployment:
# changing it changes every user's backup keys.
VITE_APP_DOMAIN=latch-dial.localhost

# Optional product-layer service (worker/). Leave unset to run without it.
VITE_SERVICE_URL=
VITE_TEST_MINT=2fZy4obHV2oUBqptHiANRmQU4A2vF8fTriT1mTPVLANi   # Latch Demo Dollar (LDD); demo.ts can mint it
VITE_TELEGRAM_BOT=
VITE_TELEGRAM_WIDGET_URL=
VITE_TELEGRAM_OIDC_CLIENT_ID=
# Set to 1 only for a build whose service publishes the retention and legal-process pages.
VITE_IDENTITY_LIVE=
